  journal = {Process Safety and Environmental Protection},
  volume = {202},
  pages = {107659},
  issn = {09575820},
  doi = {10.1016/j.psep.2025.107659},
  urldate = {2026-10-24},
  abstract = {Nowadays, the issue of antibiotic and heavy metal pollution in water bodies is a growing concern. In this paper, a recyclable and reusable graphene oxide-based hydrogel (PGOT@GEL) was prepared to reveal its adsorption behavior and mechanism of ciprofloxacin (CIP), gatifloxacin (GAT) and Cu2+. The adsorption process of CIP and GAT conformed to the pseudo-second-order and Langmuir models with maximum adsorption capacities of 821.24 and 755.96 mg/g, respectively. Meanwhile, the theoretical equations for the adsorption capacity were derived from the optimization of antibiotic adsorption process by response surface methodology. PGOT@GEL showed good adsorption capacity in real water samples and had good reusability. In the binary system, the interactions between CIP and Cu2+ were explored by the adsorption capacity ratio, where the coexistence of the two promoted their adsorption to each other. FTIR and XPS analyses showed that the adsorption mechanism for antibiotics mainly involved electrostatic interaction, {$\pi$}-{$\pi$} interaction, and hydrogen bonding. And the contribution of the above forces in different pH ranges was explored using CIP as example. Furthermore, the coadsorption mechanism of CIP and Cu2+ introduced coordination and bridging effects in the binary system. Overall, this study offered a valuable reference for the synergistic treatment of antibiotics and heavy metals.},
  langid = {english},
  file = {/Users/mac/Zotero/storage/W2NCYHLU/Li et al. - 2025 - Three-dimensional graphene oxide-based hydrogel for the removal of fluoroquinolone antibiotics and C.pdf}
