@article{liThreedimensionalGrapheneOxidebased2025,
  title = {Three-Dimensional Graphene Oxide-Based Hydrogel for the Removal of Fluoroquinolone Antibiotics and {{Cu2}} + : {{RSM}} Optimization, Co-Adsorption and Mechanistic Studies},
  shorttitle = {Three-Dimensional Graphene Oxide-Based Hydrogel for the Removal of Fluoroquinolone Antibiotics and {{Cu2}} +},
  author = {Li, Keran and Yang, Xiaoyu and Li, Jiaxin and Li, Shengping and Chen, Qingyuan},
  year = 2025,
